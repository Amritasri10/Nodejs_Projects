{
  "info": {
    "name": "Notes API",
    "_postman_id": "notes-api-collection",
    "description": "Complete Notes API with JWT Auth, CRUD, search by content, tags filter, and pagination",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token – auto-saved after login or register"
    },
    {
      "key": "noteId",
      "value": "",
      "type": "string",
      "description": "Note _id – auto-saved after Create Note"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Check if the server is running"
      },
      "response": []
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amrita Srivastava\",\n  \"email\": \"amrita@example.com\",\n  \"password\": \"amrita123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user. Token is auto-saved to collection variable."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amrita@example.com\",\n  \"password\": \"amrita123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login user. Token is auto-saved to collection variable."
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            },
            "description": "Get logged-in user profile. Requires token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Create Note",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "  pm.collectionVariables.set('noteId', res.data._id);",
                  "  console.log('noteId saved:', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Note\",\n  \"content\": \"This is the content of my first note.\",\n  \"tags\": [\"personal\", \"ideas\"],\n  \"isPinned\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"]
            },
            "description": "Create a new note. noteId is auto-saved after creation."
          },
          "response": []
        },
        {
          "name": "Create Pinned Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Important Meeting Notes\",\n  \"content\": \"Discuss project deadline and deliverables with team.\",\n  \"tags\": [\"work\", \"meeting\"],\n  \"isPinned\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"]
            },
            "description": "Create a pinned note. Pinned notes appear at the top."
          },
          "response": []
        },
        {
          "name": "Get All Notes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"]
            },
            "description": "Get all notes of the logged-in user. Pinned notes appear first."
          },
          "response": []
        },
        {
          "name": "Get All Notes - Search by Title",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?search=meeting",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                {
                  "key": "search",
                  "value": "meeting",
                  "description": "Search by title or content (case-insensitive)"
                }
              ]
            },
            "description": "Search notes by title or content"
          },
          "response": []
        },
        {
          "name": "Get All Notes - Search by Content",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?search=deadline",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                {
                  "key": "search",
                  "value": "deadline",
                  "description": "Searches inside content field too"
                }
              ]
            },
            "description": "Search notes by content text"
          },
          "response": []
        },
        {
          "name": "Get All Notes - Filter by Tag",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?tags=work",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                {
                  "key": "tags",
                  "value": "work",
                  "description": "Filter by single tag"
                }
              ]
            },
            "description": "Filter notes by a single tag"
          },
          "response": []
        },
        {
          "name": "Get All Notes - Filter by Multiple Tags",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?tags=work,personal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                {
                  "key": "tags",
                  "value": "work,personal",
                  "description": "Comma-separated tags – returns notes matching any tag"
                }
              ]
            },
            "description": "Filter notes by multiple tags (comma-separated)"
          },
          "response": []
        },
        {
          "name": "Get All Notes - Filter Pinned Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?isPinned=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                {
                  "key": "isPinned",
                  "value": "true",
                  "description": "true | false"
                }
              ]
            },
            "description": "Get only pinned notes"
          },
          "response": []
        },
        {
          "name": "Get All Notes - Pagination",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number (default: 1)" },
                { "key": "limit", "value": "5", "description": "Items per page (default: 10)" }
              ]
            },
            "description": "Paginate notes"
          },
          "response": []
        },
        {
          "name": "Get All Notes - Sort by Oldest",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?sortBy=oldest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                {
                  "key": "sortBy",
                  "value": "oldest",
                  "description": "recent | oldest (default: recent)"
                }
              ]
            },
            "description": "Sort notes oldest first"
          },
          "response": []
        },
        {
          "name": "Get All Notes - No Pagination",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?isPagination=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                {
                  "key": "isPagination",
                  "value": "false",
                  "description": "Pass false to get all notes without pagination"
                }
              ]
            },
            "description": "Fetch all notes in one go without pagination"
          },
          "response": []
        },
        {
          "name": "Get All Notes - All Filters Combined",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes?search=meeting&tags=work&isPinned=true&page=1&limit=5&sortBy=recent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"],
              "query": [
                { "key": "search",     "value": "meeting",  "description": "Search title or content" },
                { "key": "tags",       "value": "work",     "description": "Filter by tag" },
                { "key": "isPinned",   "value": "true",     "description": "true | false" },
                { "key": "page",       "value": "1" },
                { "key": "limit",      "value": "5" },
                { "key": "sortBy",     "value": "recent",   "description": "recent | oldest" }
              ]
            },
            "description": "All filters together – search + tags + isPinned + pagination + sort"
          },
          "response": []
        },
        {
          "name": "Get Note by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes", "{{noteId}}"]
            },
            "description": "Get a single note by ID. noteId is auto-set after Create Note."
          },
          "response": []
        },
        {
          "name": "Update Note",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Note Title\",\n  \"content\": \"Updated content here.\",\n  \"tags\": [\"work\", \"updated\"],\n  \"isPinned\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes", "{{noteId}}"]
            },
            "description": "Update any fields of a note. Only the owner can update."
          },
          "response": []
        },
        {
          "name": "Pin / Unpin Note",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPinned\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes", "{{noteId}}"]
            },
            "description": "Toggle isPinned true/false to pin or unpin a note"
          },
          "response": []
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes", "{{noteId}}"]
            },
            "description": "Delete a note by ID. Only the owner can delete."
          },
          "response": []
        }
      ]
    }
  ]
}
