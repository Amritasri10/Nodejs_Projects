{
  "info": {
    "name": "URL Shortener API",
    "_postman_id": "url-shortener-api-collection",
    "description": "URL Shortener API with custom alias, click analytics and expiry",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:5003", "type": "string" },
    { "key": "urlId",     "value": "", "type": "string", "description": "URL _id – auto-saved after Create" },
    { "key": "shortCode", "value": "", "type": "string", "description": "shortCode – auto-saved after Create" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api","health"] }
      },
      "response": []
    },
    {
      "name": "URLs",
      "item": [
        {
          "name": "Create Short URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "  pm.collectionVariables.set('urlId', res.data._id);",
                  "  pm.collectionVariables.set('shortCode', res.data.shortCode);",
                  "  console.log('urlId:', res.data._id, 'shortCode:', res.data.shortCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://www.google.com/search?q=nodejs+express+tutorial\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/urls", "host": ["{{baseUrl}}"], "path": ["api","urls"] },
            "description": "Create a short URL with auto-generated code. urlId and shortCode are auto-saved."
          },
          "response": []
        },
        {
          "name": "Create Short URL - Custom Alias",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://github.com/Amritasri10/Nodejs_Projects\",\n  \"customAlias\": \"my-github\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/urls", "host": ["{{baseUrl}}"], "path": ["api","urls"] },
            "description": "Create short URL with a custom alias. Access via http://localhost:5003/my-github"
          },
          "response": []
        },
        {
          "name": "Create Short URL - With Expiry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://www.youtube.com\",\n  \"expiresAt\": \"2026-12-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/urls", "host": ["{{baseUrl}}"], "path": ["api","urls"] },
            "description": "Create a short URL that expires on a specific date."
          },
          "response": []
        },
        {
          "name": "Redirect Short URL (Browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{shortCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{shortCode}}"]
            },
            "description": "Opens short URL → redirects to original URL (302). Click count increments."
          },
          "response": []
        },
        {
          "name": "Get All URLs",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/urls", "host": ["{{baseUrl}}"], "path": ["api","urls"] },
            "description": "Get all short URLs."
          },
          "response": []
        },
        {
          "name": "Get All URLs - Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/urls?search=github",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls"],
              "query": [{ "key": "search", "value": "github", "description": "Search by originalUrl, shortCode or customAlias" }]
            },
            "description": "Search URLs by originalUrl, shortCode or alias."
          },
          "response": []
        },
        {
          "name": "Get All URLs - Filter Active",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/urls?isActive=true",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls"],
              "query": [{ "key": "isActive", "value": "true", "description": "true | false" }]
            },
            "description": "Filter active or inactive URLs."
          },
          "response": []
        },
        {
          "name": "Get All URLs - Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/urls?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls"],
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get All URLs - Sort Oldest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/urls?sortBy=oldest",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls"],
              "query": [{ "key": "sortBy", "value": "oldest" }]
            }
          },
          "response": []
        },
        {
          "name": "Get URL by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/urls/{{urlId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls","{{urlId}}"]
            },
            "description": "Get a single URL by MongoDB _id."
          },
          "response": []
        },
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/urls/{{urlId}}/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls","{{urlId}}","analytics"]
            },
            "description": "Get click analytics — total clicks, recent 10 clicks with IP and timestamp."
          },
          "response": []
        },
        {
          "name": "Update URL",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://www.github.com\",\n  \"isActive\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/urls/{{urlId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls","{{urlId}}"]
            },
            "description": "Update originalUrl or isActive status."
          },
          "response": []
        },
        {
          "name": "Deactivate URL",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/urls/{{urlId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls","{{urlId}}"]
            },
            "description": "Deactivate a short URL without deleting it."
          },
          "response": []
        },
        {
          "name": "Delete URL",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/urls/{{urlId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","urls","{{urlId}}"]
            },
            "description": "Permanently delete a short URL."
          },
          "response": []
        }
      ]
    }
  ]
}
